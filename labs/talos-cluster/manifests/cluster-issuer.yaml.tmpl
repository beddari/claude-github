# acme-env's step-ca over ACME, trusted through caBundle, acme-env's root.
# DNS-01 for *.__ZONE__, through acme-env's BIND with the TSIG secret that
# bin/issuer makes; HTTP-01 through Traefik for every other name.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: step-ca
spec:
  acme:
    server: https://ca.__ZONE__:__CA_PORT__/acme/acme/directory
    caBundle: __CA_BUNDLE__
    privateKeySecretRef:
      name: step-ca-acme-account
    solvers:
      - http01:
          ingress:
            ingressClassName: traefik
      - selector:
          dnsNames: ["*.__ZONE__"]
        dns01:
          rfc2136:
            nameserver: __HOST_IP__:__DNS_UPDATE_PORT__
            tsigKeyName: __TSIG_NAME__
            tsigAlgorithm: HMACSHA256
            tsigSecretSecretRef:
              name: lab-dns01-tsig
              key: secret
