# cert-manager → acme-env's step-ca over ACME HTTP-01, solved by Traefik.
# caBundle lets cert-manager trust step-ca's TLS endpoint.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: step-ca
spec:
  acme:
    server: https://ca.__ZONE__:__CA_PORT__/acme/acme/directory
    caBundle: __CA_BUNDLE__
    privateKeySecretRef:
      name: step-ca-acme-account
    solvers:
      - http01:
          ingress:
            ingressClassName: traefik
