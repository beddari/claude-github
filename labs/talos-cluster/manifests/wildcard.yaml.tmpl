# Demo of the wildcard: a certificate for *.__ZONE__ over DNS-01, and an
# Ingress for hello.__ZONE__ that serves it. The Ingress has no
# cert-manager annotation: it uses the wildcard's Secret as it is.
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: wildcard
  namespace: whoami
spec:
  secretName: wildcard-tls
  dnsNames: ["*.__ZONE__"]
  issuerRef:
    kind: ClusterIssuer
    name: step-ca
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: hello
  namespace: whoami
spec:
  ingressClassName: traefik
  tls:
    - hosts: [hello.__ZONE__]
      secretName: wildcard-tls
  rules:
    - host: hello.__ZONE__
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: whoami
                port:
                  number: 80
