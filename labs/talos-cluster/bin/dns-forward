#!/usr/bin/env bash
#
# Makes the cluster's CoreDNS forward the lab zone to acme-env's CoreDNS,
# over TCP: UDP replies from the host did not come back on GitHub's runners.
# Replaces an older block for the zone; does nothing when it is current.
#

source "${0%/*}/functions.sh" || exit $?

block="$zone:53 {
    errors
    cache 5
    forward . $host_ip:$dns_port {
        force_tcp
    }
}"

corefile="$(kubectl -n kube-system get cm coredns \
	-o jsonpath='{.data.Corefile}')" || fail "Reading the Corefile failed!"

if [[ "$corefile" == *"forward . $host_ip:$dns_port {"* ]]; then
	log "CoreDNS already forwards $zone to $host_ip:$dns_port"
	exit 0
fi

base="$(awk -v zone="$zone:53 {" '
	$0 == zone { skip = 1 }
	!skip      { print }
	skip && /^}/ { skip = 0 }
' <<< "$corefile")"

log "Forwarding $zone to $host_ip:$dns_port over TCP ..."
kubectl -n kube-system patch cm coredns --type merge -p "$(jq -n \
	--arg c "$base"$'\n\n'"$block" '{data: {Corefile: $c}}')" >/dev/null ||
	fail "Patching the Corefile failed!"
kubectl -n kube-system rollout restart deploy/coredns >/dev/null ||
	fail "Restarting CoreDNS failed!"
kubectl -n kube-system rollout status deploy/coredns --timeout=120s ||
	fail "CoreDNS did not come back!"
