#!/usr/bin/env bash
#
# The end-to-end test:
#
# - the API server's certificate chains to acme-env's root, through the
#   cluster's CA;
# - a pod on every node resolves ca.<zone>;
# - whoami.<zone> has a certificate over HTTP-01 and a record from
#   external-dns, and serves HTTPS that the root trusts;
# - *.<zone> has a certificate over DNS-01, which hello.<zone> serves.
#

source "${0%/*}/functions.sh" || exit $?

#
# Tells whether a name resolves to the worker through acme-env.
#
function resolves()
{
	[[ "$(dig @"$host_ip" -p "$dns_port" +short "$1" | tail -1)" == \
		"$worker_ip" ]]
}

#
# Tells whether a name serves HTTPS with a certificate the lab's root
# trusts.
#
function serves()
{
	curl -fsS --noproxy '*' --cacert "$root_ca" \
		--resolve "$1:443:$worker_ip" "https://$1/" |
		grep -E '^(Hostname|Host):'
}

#
# Prints the names, issuer and expiry of the certificate a name serves. An
# ACME certificate has its names only there; its subject is empty.
#
function served_cert()
{
	echo | openssl s_client -connect "$worker_ip:443" -servername "$1" \
		2>/dev/null |
		openssl x509 -noout -ext subjectAltName -issuer -enddate
}

#
# Tells whether a pod on a node resolves ca.<zone> through kube-dns. Run on
# every node, it covers the pod that shares its node with CoreDNS.
#
function resolves_on()
{
	local node="$1"

	kubectl run "dns-probe-$node" --rm -i --quiet --restart=Never \
		--image=docker.io/library/busybox:1.37 --overrides="{\"spec\":
		{\"nodeName\": \"$node\", \"tolerations\": [{\"operator\":
		\"Exists\"}]}}" -- nslookup "ca.$zone." 2>/dev/null |
		grep -q "$host_ip"
}

#
# Verifies the API server's certificate against the root, with the
# cluster's CA as the only intermediate.
#
function api_chains_to_root()
{
	local server

	server="$(kubectl config view --raw \
		-o jsonpath='{.clusters[0].cluster.server}')" || return $?
	echo | openssl s_client -connect "${server#https://}" 2>/dev/null |
		openssl x509 > "$run_dir/apiserver.crt" || return $?
	openssl verify -CAfile "$root_ca" -untrusted "$ca_dir/ca.crt" \
		"$run_dir/apiserver.crt" >/dev/null
}

api_chains_to_root ||
	fail "The API server's certificate does not chain to the lab's root!"
log "The API server's certificate chains to the lab's root:"
openssl x509 -in "$ca_dir/ca.crt" -noout -subject -issuer

for node in $(kubectl get nodes -o name); do
	node="${node#node/}"
	resolves_on "$node" || fail "A pod on $node cannot resolve ca.$zone!"
	log "A pod on $node resolves ca.$zone"
done

kubectl -n whoami wait certificate/whoami-tls --for=condition=Ready \
	--timeout=300s || fail "The certificate for whoami is not Ready!"
retry 60 resolves "whoami.$zone" ||
	fail "whoami.$zone does not resolve to $worker_ip!"
log "whoami.$zone -> $worker_ip, published by external-dns"
# Traefik loads a new secret a few seconds after the Certificate is Ready.
retry 30 serves "whoami.$zone" ||
	fail "whoami.$zone serves no certificate the lab's root trusts!"
served_cert "whoami.$zone"

kubectl -n whoami wait certificate/wildcard --for=condition=Ready \
	--timeout=300s || fail "The wildcard certificate is not Ready!"
log "*.$zone was issued over DNS-01"
retry 60 resolves "hello.$zone" ||
	fail "hello.$zone does not resolve to $worker_ip!"
retry 30 serves "hello.$zone" ||
	fail "hello.$zone serves no certificate the lab's root trusts!"
served_cert "hello.$zone"

log "All good: CA chain, whoami.$zone over HTTP-01, *.$zone over DNS-01."
