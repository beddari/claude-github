#!/usr/bin/env bash
#
# Writes .run/kubeconfig and waits for every node to be Ready.
#

source "${0%/*}/functions.sh" || exit $?

talosctl kubeconfig "$KUBECONFIG" --nodes "$cp_ip" --merge=false --force ||
	fail "Fetching the kubeconfig failed!"
kubectl wait --for=condition=Ready nodes --all --timeout=300s ||
	fail "The nodes did not become Ready!"
log "export KUBECONFIG=$KUBECONFIG"
