# Settings shared by the labs, sourced by lab.sh. Each one is a default that
# the environment overrides.

# DNS zone served by acme-env's CoreDNS and certified by its step-ca.
ZONE="${ZONE:-lab.test}"
# Ports on the host network.
DNS_PORT="${DNS_PORT:-1053}"
CA_PORT="${CA_PORT:-8443}"
ETCD_PORT="${ETCD_PORT:-23790}"
ETCD_PEER_PORT="${ETCD_PEER_PORT:-23800}"
# BIND, which takes DNS-01 challenges as RFC 2136 updates signed with TSIG.
DNS_UPDATE_PORT="${DNS_UPDATE_PORT:-1054}"
# Resolvers for names outside ZONE, in place of the host's:
# labs/docs/troubleshooting.md.
UPSTREAM_DNS="${UPSTREAM_DNS:-1.1.1.1 9.9.9.9}"
# The address the labs advertise for ca.ZONE, etcd and DNS, reachable from
# containers and Talos nodes. Empty: the source address of the default route.
HOST_IP="${HOST_IP:-}"
