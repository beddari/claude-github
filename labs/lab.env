# Settings shared by the labs. Sourced by lab.sh; each one is a default that
# the environment overrides, so acme-env and its consumers always agree.

# DNS zone served by acme-env's CoreDNS and certified by its step-ca.
ZONE="${ZONE:-lab.test}"
# Ports on the host. All unprivileged; the services use the host network.
DNS_PORT="${DNS_PORT:-1053}"
CA_PORT="${CA_PORT:-8443}"
ETCD_PORT="${ETCD_PORT:-23790}"
ETCD_PEER_PORT="${ETCD_PEER_PORT:-23800}"
# Resolvers for names outside ZONE. Explicit, not /etc/resolv.conf, which
# would loop on a host that runs systemd-resolved.
UPSTREAM_DNS="${UPSTREAM_DNS:-1.1.1.1 9.9.9.9}"
# The address the labs advertise for ca.ZONE, etcd and DNS. Containers and
# Talos nodes must reach it. Empty: the source address of the default route.
HOST_IP="${HOST_IP:-}"
