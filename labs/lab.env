# Shared settings for the labs/ environments. Plain KEY=value, sourced by
# each lab's Taskfile, so acme-env and its consumers always agree.

# DNS zone served by acme-env's CoreDNS and certified by its step-ca.
ZONE=lab.test
# Ports on the host (all unprivileged; services run with host networking).
DNS_PORT=1053
CA_PORT=8443
ETCD_PORT=23790
ETCD_PEER_PORT=23800
# Resolvers for everything outside ZONE. Explicit, not /etc/resolv.conf,
# to avoid a forwarding loop when the host itself runs systemd-resolved.
UPSTREAM_DNS="1.1.1.1 9.9.9.9"
# Host address the lab advertises (ca.ZONE, etcd, DNS). Empty = autodetect
# the primary IPv4 address. Containers and Talos nodes must reach it.
HOST_IP=
