// Rendered by bin/render into .run/bind/named.conf. One zone, for DNS-01
// tokens; CoreDNS forwards it here.
options {
	directory "/var/lib/bind";
	listen-on port __DNS_UPDATE_PORT__ { any; };
	listen-on-v6 { none; };
	recursion no;
	allow-query { any; };
	pid-file none;
};

key "__TSIG_NAME__" {
	algorithm hmac-sha256;
	secret "__TSIG_SECRET__";
};

zone "_acme-challenge.__ZONE__" {
	type primary;
	file "/var/lib/bind/challenge.db";
	allow-update { key "__TSIG_NAME__"; };
};
