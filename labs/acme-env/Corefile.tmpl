# Rendered by bin/render into .run/Corefile (__VARS__ come from ../lab.env).

# The lab zone: ca.__ZONE__ is pinned to the host; everything else in the
# zone is read from etcd, where external-dns (coredns provider) writes it.
__ZONE__:__DNS_PORT__ {
    hosts {
        __HOST_IP__ ca.__ZONE__
        fallthrough
    }
    etcd __ZONE__ {
        path /skydns
        endpoint http://127.0.0.1:__ETCD_PORT__
    }
    log
    errors
}

# Everything else: forward upstream (split DNS).
.:__DNS_PORT__ {
    forward . __UPSTREAM_DNS__
    cache 300
    errors
}

# DNS-01 challenges, as for a wildcard: BIND holds this one zone and takes
# RFC 2136 updates for it, signed with TSIG. CoreDNS cannot take updates.
_acme-challenge.__ZONE__:__DNS_PORT__ {
    forward . 127.0.0.1:__DNS_UPDATE_PORT__
    errors
}
